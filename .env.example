# Copia este archivo a .env y rellénalo. NUNCA subas .env al repo.

# --- obligatorio en todos los entornos ---
# Firma las cookies de sesión. Genera uno:
#   openssl rand -hex 32
SESSION_SECRET=

# --- despliegue en Vercel: contenido en el repo ---
# Formato "usuario/repositorio". El token necesita permiso de escritura
# (contents:write) sobre ese repositorio.
STORE=github
GITHUB_REPO=EAJRD/Multimedia-EFR
GITHUB_BRANCH=main
GITHUB_TOKEN=

# --- despliegue en Docker: contenido en un volumen SQLite ---
# STORE=sqlite
# DATABASE_PATH=/data/multimedios.sqlite

# --- opcional ---
NODE_ENV=production
PORT=3000
